{
  "name": "how-much",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @how-much/web --filter @how-much/api dev",
    "dev:worker": "pnpm --filter @how-much/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @how-much/db migrate",
    "db:deploy": "pnpm --filter @how-much/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @how-much/db seed",
    "db:studio": "pnpm --filter @how-much/db studio",
    "db:seed:demo": "pnpm --filter @how-much/api seed:demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
