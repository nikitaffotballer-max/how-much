# Скопируйте в .env и при необходимости поменяйте значения.
NODE_ENV=development

# API
API_PORT=3000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# Инфраструктура (docker compose up)
DATABASE_URL=postgresql://howmuch:howmuch@localhost:5432/howmuch
REDIS_URL=redis://localhost:6379


# Ключ шифрования паролей приложений от почты: 32 случайных байта в base64. Не коммитьте настоящий ключ.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_ENCRYPTION_KEY=
