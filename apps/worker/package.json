    "@how-much/mail": "workspace:*",
    "@how-much/shared": "workspace:*",
    "bullmq": "^6.3.13",
    "html-to-text": "^10.0.1",
    "ioredis": "^6.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
